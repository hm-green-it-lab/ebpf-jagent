# Default OTLP endpoint (used if no environment override)
# OTLP_ENDPOINT=http://localhost:4318/v1/metrics
OTLP_ENDPOINT=http://0.0.0.0:4318/v1/metrics

# Authentication / TLS
OTLP_BEARER_TOKEN=supersecrettoken
OTLP_CA_CERT=/etc/ssl/certs/ca.pem
OTLP_CLIENT_CERT=/etc/ssl/certs/client.pem
OTLP_CLIENT_KEY=/etc/ssl/private/client.key

# TLS behavior
OTLP_INSECURE=1

# Timeouts
OTLP_TIMEOUT_SECS=5
OTLP_CONNECT_TIMEOUT=2

# JVM Path for USDTs
JVM_LIB_PATH=/usr/lib/jvm/java-24-openjdk-amd64/lib/server/libjvm.so
